---
import { withBase } from '../utils/url';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={withBase(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
        </li>
      ))}
    </ul>
  )
}
