---
import { withBase } from '../utils/url';

const path = Astro.url.pathname;
const isHome = path === '/';
const isTags = path.startsWith('/tags');
const isAbout = path.startsWith('/about');
---

<header class="site-header">
  <a class="site-title" href={withBase('/')}>读研树洞</a>
  <nav class="site-nav" aria-label="主导航">
    <a href={withBase('/')} aria-current={isHome ? 'page' : undefined}>首页</a>
    <a href={withBase('/tags/')} aria-current={isTags ? 'page' : undefined}>标签</a>
    <a href={withBase('/about/')} aria-current={isAbout ? 'page' : undefined}>关于</a>
  </nav>
</header>
